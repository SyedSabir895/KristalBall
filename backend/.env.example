# Copy to .env and fill in real values
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/kristalball
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
# Frontend URL allowed by CORS (leave empty in local dev)
CLIENT_URL=http://localhost:5173
# Set to true when deployed behind a proxy (Render, Railway)
TRUST_PROXY=false
